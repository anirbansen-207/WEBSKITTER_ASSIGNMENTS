<!DOCTYPE html>
<html>

<head>
  <title>Users</title>
  <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<h1>All Users</h1>

<table border="1">

<tr>
<th>Name</th>
<th>Email</th>
<th>Role</th>
<th>Action</th>
</tr>

<% users.forEach(user=>{ %>

<tr>

<td>
<%= user.name %>
</td>

<td>
<%= user.email %>
</td>

<td>
<%= user.role %>
</td>

<td>

<a
href="/users/delete/<%= user._id %>">

Delete

</a>

</td>

</tr>

<% }) %>

</table>

</body>
</html>