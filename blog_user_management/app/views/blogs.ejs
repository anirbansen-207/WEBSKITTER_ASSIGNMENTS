<!DOCTYPE html>
<html>

<head>
  <title>Blogs</title>
  <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<h1>All Blogs</h1>

<% blogs.forEach(blog=>{ %>

<h3>
<%= blog.title %>
</h3>

<p>
<%= blog.content %>
</p>

<p>
Created By :
<%= blog.createdBy.name %>
</p>

<% if(blog.image){ %>

<img
src="/uploads/<%= blog.image %>"
width="200">

<% } %>

<br>

<a href="/blogs/delete/<%= blog._id %>">
Delete
</a>

<hr>

<% }) %>

</body>
</html>