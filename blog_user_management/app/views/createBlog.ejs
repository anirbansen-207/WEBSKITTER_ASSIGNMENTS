<!DOCTYPE html>
<html>

<head>
  <title>Create Blog</title>
  <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<h1>Create Blog</h1>

<form
action="/blogs"
method="POST"
enctype="multipart/form-data">

<input
type="text"
name="title"
placeholder="Title">

<br><br>

<textarea
name="content">
</textarea>

<br><br>

<input
type="file"
name="image">

<br><br>

<button type="submit">
Create
</button>

</form>

</body>
</html>